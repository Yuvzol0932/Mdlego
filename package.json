{
  "name": "mdlego",
  "version": "1.0.0-rc.2",
  "private": true,
  "license": "MIT",
  "description": "墨读 Mdlego — 离线优先的 Android Markdown 阅读器（阅读 · 批注 · 查词 · 编辑）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "check:tokens": "node tools/check-tokens.mjs",
    "check:selectors": "node tools/check-selectors.mjs",
    "check:state": "node tools/check-state.mjs",
    "smoke": "node tools/smoke-chrome.mjs",
    "shot:kit": "node tools/shot-kit.mjs",
    "shot:c": "node tools/shot-c.mjs",
    "verify": "npm run check:boundaries && npm run check:tokens && npm run check:selectors && npm run check:state && npm run typecheck && npm run test && npm run build",
    "android:sync": "node tools/push-web.mjs",
    "android:build": "npm run build && node tools/push-web.mjs && node tools/build-apk.mjs",
    "android:verify": "node tools/verify-apk.mjs",
    "android:verify-share": "node tools/verify-share.mjs all",
    "android:verify-picker": "node tools/verify-picker.mjs",
    "android:install": "node tools/install-apk.mjs",
    "verify:motion": "node tools/verify-motion.mjs",
    "shot:e": "node tools/shot-e.mjs",
    "shot:e2": "node tools/shot-e2.mjs",
    "shot:e3": "node tools/shot-e3.mjs",
    "shot:e4": "node tools/shot-e4.mjs",
    "shot:e56": "node tools/shot-e56.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.0.1",
    "@capacitor/core": "8.6.2",
    "markdown-it": "15.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@types/markdown-it": "14.1.2",
    "jsdom": "31.0.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
